{
	"name": "@lixray/database",
	"version": "0.1.0",
	"private": true,
	"packageManager": "pnpm@10.13.1",
	"scripts": {
		"start": "supabase start && supabase migration up --local && node scripts/configure-local-oauth.mjs",
		"start:ci": "supabase start --exclude edge-runtime,imgproxy,logflare,mailpit,postgres-meta,realtime,storage-api,studio,supavisor,vector",
		"stop": "supabase stop",
		"status": "supabase status",
		"env": "supabase status -o env",
		"reset": "supabase db reset",
		"test": "supabase test db",
		"test:oauth": "node --experimental-strip-types scripts/test-oauth-resource.mjs"
	},
	"devDependencies": {
		"supabase": "2.112.0"
	}
}
