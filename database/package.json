{
	"name": "@lixray/database",
	"version": "0.1.0",
	"private": true,
	"packageManager": "pnpm@10.13.1",
	"scripts": {
		"start": "node ../scripts/local-supabase.mjs start && node ../scripts/local-supabase.mjs migration up --local && node scripts/configure-local-oauth.mjs",
		"start:ci": "node ../scripts/local-supabase.mjs start --exclude edge-runtime,imgproxy,logflare,mailpit,postgres-meta,realtime,storage-api,studio,supavisor,vector",
		"stop": "node ../scripts/local-supabase.mjs stop",
		"status": "node ../scripts/local-supabase.mjs status",
		"env": "node ../scripts/local-supabase.mjs status -o env",
		"reset": "node ../scripts/local-supabase.mjs db reset",
		"test": "node ../scripts/local-supabase.mjs test db",
		"test:oauth": "node --experimental-strip-types scripts/test-oauth-resource.mjs"
	},
	"devDependencies": {
		"supabase": "2.112.0"
	}
}
