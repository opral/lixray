{
  "name": "lixray-workspace",
  "private": true,
  "scripts": {
    "check:docker-submodule-pins": "node scripts/check-docker-submodule-pins.mjs",
    "dev": "node scripts/dev.mjs",
    "test:e2e": "pnpm --dir web-app test:e2e",
    "dev:telemetry": "infisical run --env=dev -- pnpm dev",
    "deploy:worker": "infisical run --env=prod -- pnpm --dir web-app deploy:worker",
    "perf:build": "docker build -f lix-server/Dockerfile -t lixray-perf .",
    "perf:up": "docker compose up --build -d lix-server",
    "perf:down": "docker compose down",
    "perf:reset": "docker compose rm --stop --force lix-server && docker compose run --rm storage-reset",
    "perf:run": "node perf/runner.mjs",
    "perf:test": "node --test perf/test/*.test.mjs",
    "postinstall": "pnpm --dir web-app lix:build"
  },
  "devDependencies": {
    "@lix-js/sdk-release": "https://registry.npmjs.org/@lix-js/sdk/-/sdk-0.8.4.tgz"
  },
  "pnpm": {
    "overrides": {
      "@lix-js/sdk@^0.8.2": "link:vendor/lix/packages/js-sdk"
    }
  },
  "packageManager": "pnpm@10.13.1"
}
