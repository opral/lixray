{
  "name": "lixray-repository",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:telemetry": "infisical run --env=dev -- pnpm dev",
    "dev:reset-onboarding": "node scripts/reset-onboarding.mjs",
    "test:e2e": "pnpm --dir web-app test:e2e",
    "perf:build": "docker pull ghcr.io/opral/lix-server@sha256:5d59180190b2a891be77adf201e4405c4d514eb6ba4a86dd94d12c3f468b4807",
    "perf:up": "LIXRAY_STORAGE_PREFIX=local/perf docker compose up -d lix-server",
    "perf:down": "docker compose down",
    "perf:reset": "docker compose rm --stop --force lix-server && docker compose run --rm storage-reset",
    "perf:run": "node perf/runner.mjs",
    "perf:movie:remote": "node perf/movie/remote-qualification.mjs",
    "perf:test": "node --test perf/test/*.test.mjs",
    "test:dev": "node --test scripts/supabase-readiness.test.mjs",
    "ci": "node scripts/ci.mjs",
    "test:ci-scripts": "node --test .github/scripts/*.test.mjs",
    "vendor:sync": "node scripts/sync-vendor.mjs",
    "vendor:check": "node scripts/sync-vendor.mjs --check",
    "test:production-canary": "node --test scripts/check-production-lix.test.mjs",
    "postinstall": "pnpm --dir web-app lix:build"
  },
  "devDependencies": {
    "@lix-js/sdk-release": "https://registry.npmjs.org/@lix-js/sdk/-/sdk-0.11.0.tgz"
  },
  "packageManager": "pnpm@10.13.1",
  "pnpm": {
    "overrides": {
      "@lix-js/sdk": "link:vendor/lix/packages/js-sdk",
      "@lix-js/sdk-darwin-arm64": "0.12.3",
      "@lix-js/sdk-linux-arm64": "0.12.3",
      "@lix-js/sdk-linux-x64": "0.12.3",
      "@lix-js/sdk-win32-x64": "0.12.3"
    }
  }
}
