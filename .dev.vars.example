CLERK_APP_ID=<clerk-app-id>
CLERK_PUBLISHABLE_KEY=<clerk-publishable-key>
VITE_CLERK_PUBLISHABLE_KEY=<clerk-publishable-key>
CLERK_SECRET_KEY=<clerk-secret-key>

# Use memory mode for local development without R2. The Worker still injects
# SLATEDB_PATH from the active Clerk Organization id when each container starts.
SLATEDB_STORAGE=memory

# Required for production R2-backed runs.
R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_BUCKET=<bucket-name>
R2_ACCESS_KEY_ID=<access-key-id>
R2_SECRET_ACCESS_KEY=<secret-access-key>
R2_REGION=auto
