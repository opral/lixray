{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "lix-server/Dockerfile",
    "watchPatterns": [
      "lix-server/**",
      "vendor/lix",
      "vendor/lix/**",
      ".gitmodules",
      "railway.json"
    ]
  },
  "deploy": {
    "numReplicas": 1,
    "sleepApplication": true,
    "healthcheckPath": "/healthz",
    "healthcheckTimeout": 300,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10,
    "overlapSeconds": 0,
    "drainingSeconds": 30
  }
}
