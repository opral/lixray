{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "lixray",
	"account_id": "11a1a6f76d167248cc6987e978efb7e5",
	"main": "src/server.ts",
	"compatibility_date": "2026-07-07",
	"compatibility_flags": ["nodejs_compat"],
	"routes": [
		{
			"pattern": "lixray.com",
			"custom_domain": true,
		},
	],
	"observability": {
		"enabled": true,
	},
	"vars": {
		"CLERK_APP_ID": "app_3GBViGp1pL2PtKZ2jU5vMWQcSik",
		"VITE_CLERK_PUBLISHABLE_KEY": "pk_live_Y2xlcmsubGl4cmF5LmNvbSQ",
		"R2_ENDPOINT": "https://11a1a6f76d167248cc6987e978efb7e5.r2.cloudflarestorage.com",
		"R2_BUCKET": "lixray",
		"R2_REGION": "auto",
		"LIXRAY_E2E_ORG_ID": "",
		"SLATEDB_STORAGE": "r2",
		"SLATEDB_CACHE_DIR": "/tmp/lixray-slatedb-cache",
		"SLATEDB_CACHE_MAX_BYTES": "2147483648",
		"SLATEDB_BLOCK_CACHE_BYTES": "134217728",
		"SLATEDB_METADATA_CACHE_BYTES": "33554432",
	},
	"secrets": {
		"required": [
			"CLERK_SECRET_KEY",
			"R2_ACCESS_KEY_ID",
			"R2_SECRET_ACCESS_KEY",
		],
	},
	"containers": [
		{
			"class_name": "SlateDbContainer",
			"image": "./Dockerfile",
			"max_instances": 10,
			"instance_type": "basic",
		},
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "SLATEDB_CONTAINER",
				"class_name": "SlateDbContainer",
			},
		],
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["SlateDbContainer"],
		},
	],
}
