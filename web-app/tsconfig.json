{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"jsx": "react-jsx",
		"strict": true,
		"noEmit": true,
		"skipLibCheck": true,
		"allowImportingTsExtensions": true,
		"isolatedModules": true,
		"resolveJsonModule": true,
		"verbatimModuleSyntax": true,
		"types": ["node", "vite/client"],
		"paths": {
			"~/*": ["./src/*"]
		}
	},
	"include": [
		"src",
		"vite.config.ts",
		"playwright.file-component.config.ts",
		"playwright.published.config.ts",
		"tests/published",
		"tests/file-component"
	],
	"exclude": ["src/worker/**/*.test.ts"]
}
