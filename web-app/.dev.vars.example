R2_ENDPOINT=http://host.docker.internal:9000
R2_BUCKET=lixray
R2_ACCESS_KEY_ID=lixray
R2_SECRET_ACCESS_KEY=lixray-local-secret
R2_REGION=us-east-1
S3_PREFIX=local
S3_ALLOW_HTTP=true

# Optional R2-backed SlateDB cache overrides.
SLATEDB_CACHE_DIR=/tmp/lixray-slatedb-cache
SLATEDB_CACHE_MAX_BYTES=2147483648
SLATEDB_BLOCK_CACHE_BYTES=134217728
SLATEDB_METADATA_CACHE_BYTES=33554432
