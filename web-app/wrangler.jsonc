{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "lixray",
	"account_id": "11a1a6f76d167248cc6987e978efb7e5",
	"main": "src/server.ts",
	"compatibility_date": "2026-07-07",
	"compatibility_flags": ["nodejs_compat", "enable_request_signal"],
	"routes": [
		{
			"pattern": "lixray.com",
			"custom_domain": true,
		},
	],
	"observability": {
		"enabled": true,
	},
	"vars": {
		"VITE_SUPABASE_URL": "https://xpkokrinmkjqcnjzbmpe.supabase.co",
		"VITE_SUPABASE_KEY": "sb_publishable_TCXw8CWgza4PRfqYEQ6n4g_nA7aVZVj",
		"SUPABASE_URL": "https://xpkokrinmkjqcnjzbmpe.supabase.co",
		"SUPABASE_PUBLISHABLE_KEY": "sb_publishable_TCXw8CWgza4PRfqYEQ6n4g_nA7aVZVj",
		"SUPABASE_JWKS_URL": "https://xpkokrinmkjqcnjzbmpe.supabase.co/auth/v1/.well-known/jwks.json",
		"R2_ENDPOINT": "https://11a1a6f76d167248cc6987e978efb7e5.r2.cloudflarestorage.com",
		"R2_BUCKET": "lixray",
		"R2_REGION": "auto",
		"SLATEDB_CACHE_DIR": "/tmp/lixray-slatedb-cache",
		"SLATEDB_CACHE_MAX_BYTES": "2147483648",
		"SLATEDB_BLOCK_CACHE_BYTES": "134217728",
		"SLATEDB_METADATA_CACHE_BYTES": "33554432",
	},
	"secrets": {
		"required": ["R2_ACCESS_KEY_ID", "R2_SECRET_ACCESS_KEY"],
	},
	"containers": [
		{
			"class_name": "SlateDbContainer",
			"image": "../lix-server/Dockerfile",
			"image_build_context": "..",
			"max_instances": 1000,
			"instance_type": "basic",
		},
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "SLATEDB_CONTAINER",
				"class_name": "SlateDbContainer",
			},
		],
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["SlateDbContainer"],
		},
	],
}
