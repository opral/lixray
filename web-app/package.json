{
	"name": "@lixray/web-app",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@10.13.1",
	"scripts": {
		"check:cloudflare": "pnpm typecheck && pnpm test:analytics && pnpm test:auth && pnpm test:file-explorer && pnpm test:worker",
		"lix:build": "node ../scripts/prepare-vendored-lix-sdk.mjs",
		"atelier:build": "pnpm --filter @opral/atelier exec vite build && pnpm --filter @opral/atelier exec tsc -p tsconfig.build.json --noCheck && pnpm --filter @opral/atelier exec node scripts/prune-types.mjs",
		"prebuild": "pnpm lix:build && pnpm atelier:build",
		"prelint": "pnpm lix:build && pnpm atelier:build",
		"pretypecheck": "pnpm lix:build && pnpm atelier:build",
		"format": "oxfmt --write --ignore-path .oxfmtignore .",
		"format:check": "oxfmt --check --ignore-path .oxfmtignore .",
		"lint": "eslint . --max-warnings=0",
		"build": "pnpm run routes:generate && pnpm run mcp:tools:generate && vite build",
		"build:node": "LIXRAY_WORKER_TARGET=railway LIXRAY_SKIP_VENDORED_LIX_WASM=1 pnpm build",
		"build:railway": "VITE_LIXRAY_DEMO=1 LIXRAY_DEMO=1 pnpm build:node",
		"start:railway": "node scripts/start-railway.mjs",
		"deploy:worker": "pnpm run build && wrangler deploy --config ./dist/server/wrangler.json",
		"routes:generate": "node scripts/generate-routes.mjs",
		"test:e2e": "playwright test",
		"test:analytics": "node --test --experimental-strip-types src/lib/*telemetry*.test.ts",
		"test:auth": "node --test --experimental-strip-types src/lib/auth-return-to.test.ts",
		"test:file-explorer": "node --test --experimental-strip-types src/lib/file-download-batches.test.ts",
		"test:worker": "node --test --experimental-strip-types src/worker/*.test.ts src/mcp/*.test.ts",
		"check:mcp": "node scripts/check-mcp-connection.mjs",
		"mcp:tools:generate": "node --experimental-strip-types scripts/generate-mcp-tools.mjs",
		"typecheck": "pnpm run routes:generate && tsc --noEmit",
		"cf-typegen": "wrangler types --config ./wrangler.jsonc"
	},
	"dependencies": {
		"@cloudflare/containers": "0.3.7",
		"@lix-js/sdk": "workspace:*",
		"@modelcontextprotocol/sdk": "1.29.0",
		"@opral/atelier": "workspace:*",
		"@supabase/supabase-js": "^2.110.2",
		"@tanstack/react-router": "^1.170.17",
		"@tanstack/react-start": "^1.168.27",
		"agents": "0.17.3",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"fflate": "^0.8.3",
		"jose": "^6.2.3",
		"lucide-react": "^1.23.0",
		"posthog-js": "^1.400.1",
		"posthog-node": "^5.42.0",
		"radix-ui": "^1.6.2",
		"react": "^19.2.7",
		"react-dom": "^19.2.7",
		"sonner": "^2.0.7",
		"tailwind-merge": "^3.6.0",
		"zod": "4.4.3"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "^1.43.0",
		"@cloudflare/workers-types": "4.20260701.1",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.61.1",
		"@tailwindcss/vite": "^4.3.2",
		"@tanstack/router-generator": "^1.167.18",
		"@types/node": "^22.20.0",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^6.0.3",
		"eslint": "^10.6.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-react-hooks": "^7.1.1",
		"globals": "^17.7.0",
		"oxfmt": "^0.58.0",
		"tailwindcss": "^4.3.2",
		"tw-animate-css": "^1.4.0",
		"typescript": "^5.9.2",
		"typescript-eslint": "^8.63.0",
		"vite": "^8.1.3",
		"wrangler": "^4.107.0"
	}
}
