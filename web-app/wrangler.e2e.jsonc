{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "lixray-e2e",
	"main": "src/preview-server.ts",
	"compatibility_date": "2026-07-07",
	"compatibility_flags": [
		"nodejs_compat",
		"enable_request_signal",
		// The in-memory workspace runtime notifies long-lived SSE observers from
		// the requests that mutate shared state; canceling those cross-request
		// continuations kills live connections mid-flight.
		"no_handle_cross_request_promise_resolution",
	],
	"r2_buckets": [
		{
			"binding": "PREVIEW_STATE",
			"bucket_name": "lixray-preview",
		},
	],
	"vars": {
		"LIXRAY_DEMO": "",
		"LIXRAY_DEMO_WORKSPACE_IDS": "",
	},
}
