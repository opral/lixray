									"kind": {
										"type": "string",
										"const": "int"
									},
									"value": {
										"type": "integer",
										"minimum": -9007199254740991,
										"maximum": 9007199254740991
									}
								},
								"required": ["kind", "value"],
								"additionalProperties": false
							},
							{
								"type": "object",
								"properties": {
									"kind": {
										"type": "string",
										"const": "float"
									},
									"value": {
										"type": "number"
									}
								},
								"required": ["kind", "value"],
								"additionalProperties": false
							},
							{
								"type": "object",
								"properties": {
									"kind": {
										"type": "string",
										"const": "text"
									},
									"value": {
										"type": "string"
									}
								},
								"required": ["kind", "value"],
								"additionalProperties": false
							},
							{
								"type": "object",
								"properties": {
									"kind": {
										"type": "string",
										"const": "blob"
									},
									"base64": {
										"type": "string"
									}
								},
								"required": ["kind", "base64"],
								"additionalProperties": false
							},
							{
								"type": "object",
								"properties": {
									"kind": {
										"type": "string",
										"const": "json"
									},
									"value": {}
								},
								"required": ["kind", "value"],
								"additionalProperties": false
							}
						]
					}
				}
			},
			"required": ["context", "sql"],
			"additionalProperties": false
		},
		"outputSchema": {
			"$schema": "https://json-schema.org/draft/2020-12/schema",
			"type": "object",
			"properties": {
				"context": {
					"type": "string",
					"minLength": 1,
					"description": "Opaque Lix context returned by open_lix or switch_branch"
				},
				"result": {
					"type": "object",
					"properties": {
						"columns": {
							"type": "array",
							"items": {
								"type": "string"
							}
						},
						"rows": {
							"type": "array",
							"items": {
								"type": "array",
								"items": {}
							},
							"description": "Rows of wire values in the same {kind, value} shape as params"
						},
						"rowsAffected": {
							"type": "integer",
							"minimum": -9007199254740991,
							"maximum": 9007199254740991
						},
						"notices": {
							"type": "array",
							"items": {}
						}
					},
					"required": ["columns", "rows", "rowsAffected", "notices"],
					"additionalProperties": false
				},
				"request_id": {
					"type": "string",
					"minLength": 1,
					"description": "Request ID for correlating this response with server telemetry"
				}
			},
			"required": ["context", "result", "request_id"],
			"additionalProperties": false
		},
		"annotations": {
			"readOnlyHint": true,
			"destructiveHint": false,
			"openWorldHint": false
		},
		"_meta": {
