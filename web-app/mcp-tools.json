[
	{
		"name": "list_lixes",
		"title": "LixRay: Discover lixes",
		"description": "List the lixes the signed-in user can access, each as @handle/slug plus uuid. Call only when the target Lix is unknown; With an exact reference, use open_lix for file-tool context or lix_ref directly for SQL.",
		"inputSchema": {
			"$schema": "https://json-schema.org/draft/2020-12/schema",
			"type": "object",
			"properties": {},
			"additionalProperties": false
		},
		"outputSchema": {
			"$schema": "https://json-schema.org/draft/2020-12/schema",
			"type": "object",
			"properties": {
				"lixes": {
					"type": "array",
					"items": {
						"type": "object",
						"properties": {
							"id": {
								"type": "string"
							},
							"name": {
								"type": "string"
							},
							"slug": {
								"type": "string"
							},
							"namespace": {
								"type": "object",
								"properties": {
									"handle": {
										"type": "string"
									}
								},
								"required": ["handle"],
								"additionalProperties": false
							}
						},
						"required": ["id", "name", "slug", "namespace"],
						"additionalProperties": false
					}
				}
			},
			"required": ["lixes"],
			"additionalProperties": false
		},
		"annotations": {
			"readOnlyHint": true,
			"destructiveHint": false,
			"openWorldHint": false
		},
		"_meta": {
			"securitySchemes": [
				{
					"type": "noauth"
				}
			]
		}
	},
	{
		"name": "open_lix",
		"title": "LixRay: Open a Lix",
		"description": "Open exact @handle/slug or UUID without calling list_lixes first and mint context (active branch unless branch_id is given). Optional for SQL. Returns counts, file_paths (SQL paths, not URLs), and files with id, path, canonical url; when file_paths_complete is true, do not list files again.",
		"inputSchema": {
			"$schema": "https://json-schema.org/draft/2020-12/schema",
			"type": "object",
			"properties": {
				"lix_ref": {
					"type": "string",
					"minLength": 1,
					"description": "Lix UUID, slug, or @namespace/slug reference"
				},
				"branch_id": {
					"type": "string",
					"minLength": 1,
					"description": "Lix branch id"
				}
			},
			"required": ["lix_ref"],
			"additionalProperties": false
		},
		"outputSchema": {
			"$schema": "https://json-schema.org/draft/2020-12/schema",
			"type": "object",
			"properties": {
				"context": {
					"type": "string",
					"minLength": 1,
					"description": "Opaque Lix context returned by SQL tools, open_lix or switch_branch"
				},
				"context_expires_at": {
					"type": "string"
				},
				"id": {
					"type": "string"
				},
				"url": {
					"type": "string"
				},
				"lix_ref": {
					"type": "string"
				},
				"name": {
					"type": "string"
				},
				"branch_id": {
					"type": "string",
					"minLength": 1,
					"description": "Lix branch id"
				},
				"commit_id": {
					"type": "string"
				},
				"file_count": {
					"type": "integer",
					"minimum": -9007199254740991,
					"maximum": 9007199254740991
				},
				"directory_count": {
					"type": "integer",
					"minimum": -9007199254740991,
					"maximum": 9007199254740991
				},
				"files": {
					"type": "array",
					"items": {
						"type": "object",
						"properties": {
							"id": {
								"type": "string"
							},
							"path": {
								"type": "string"
							},
							"url": {
								"type": "string"
							}
						},
						"required": ["id", "path", "url"],
						"additionalProperties": false
					}
				},
				"file_paths": {
					"type": "array",
					"items": {
						"type": "string"
					}
				},
				"file_paths_complete": {
					"type": "boolean"
				},
				"file_paths_sql": {
					"type": "string"
				},
				"empty": {
					"type": "boolean"
				}
			},
			"required": [
				"context",
				"context_expires_at",
				"id",
				"url",
				"lix_ref",
				"name",
				"branch_id",
				"commit_id",
				"file_count",
				"directory_count",
				"files",
				"file_paths",
				"file_paths_complete",
				"empty"
			],
			"additionalProperties": false
		},
		"annotations": {
			"readOnlyHint": true,
			"destructiveHint": false,
			"openWorldHint": false
		},
		"_meta": {
			"securitySchemes": [
				{
					"type": "noauth"
				}
			]
		}
	},
	{
		"name": "get_entity_urls",
		"title": "LixRay: Get canonical item URLs",
		"description": "Return canonical browser URLs for up to 50 files or directories in the Lix and branch in context, each given by kind and exactly one of id or absolute path. Use after writes or renames, or for items absent from open_lix.files; copy the returned urls exactly. Read-only; directory path / is the repository URL.",
		"inputSchema": {
			"$schema": "https://json-schema.org/draft/2020-12/schema",
			"type": "object",
			"properties": {
				"context": {
					"type": "string",
					"minLength": 1,
					"description": "Opaque Lix context returned by SQL tools, open_lix or switch_branch"
				},
				"entities": {
					"minItems": 1,
					"maxItems": 50,
					"type": "array",
					"items": {
						"anyOf": [
							{
								"type": "object",
								"properties": {
									"kind": {
										"type": "string",
										"enum": ["file", "directory"]
									},
									"id": {
										"type": "string",
										"format": "uuid",
										"pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
									}
								},
								"required": ["kind", "id"],
								"additionalProperties": false
							},
							{
								"type": "object",
								"properties": {
									"kind": {
										"type": "string",
										"enum": ["file", "directory"]
									},
									"path": {
										"type": "string",
										"pattern": "^\\/.*"
									}
								},
								"required": ["kind", "path"],
								"additionalProperties": false
							}
						]
					}
				}
			},
			"required": ["context", "entities"],
			"additionalProperties": false
		},
		"outputSchema": {
			"$schema": "https://json-schema.org/draft/2020-12/schema",
			"type": "object",
			"properties": {
				"context": {
					"type": "string",
					"minLength": 1,
					"description": "Opaque Lix context returned by SQL tools, open_lix or switch_branch"
				},
				"entities": {
					"type": "array",
					"items": {
						"type": "object",
						"properties": {
							"kind": {
								"type": "string",
								"enum": ["file", "directory"]
							},
							"id": {
								"anyOf": [
									{
										"type": "string"
									},
									{
										"type": "null"
									}
								]
							},
							"path": {
								"type": "string"
							},
							"url": {
								"type": "string"
							}
						},
						"required": ["kind", "id", "path", "url"],
						"additionalProperties": false
					}
				}
			},
			"required": ["context", "entities"],
			"additionalProperties": false
		},
		"annotations": {
			"readOnlyHint": true,
			"destructiveHint": false,
			"openWorldHint": false
		},
		"_meta": {
			"securitySchemes": [
				{
					"type": "noauth"
				}
			]
		}
	},
	{
		"name": "list_files",
		"title": "LixRay: List files",
		"description": "List the files of the Lix and branch in context with id, path, and canonical url, sorted by path. Optional directory (an absolute path prefix such as /gtm) and name (a case-insensitive substring of the file name) narrow the list; truncated says to narrow further. Read-only.",
		"inputSchema": {
			"$schema": "https://json-schema.org/draft/2020-12/schema",
			"type": "object",
			"properties": {
				"context": {
					"type": "string",
					"minLength": 1,
					"description": "Opaque Lix context returned by SQL tools, open_lix or switch_branch"
				},
				"directory": {
					"type": "string",
					"minLength": 1
				},
				"name": {
					"type": "string",
					"minLength": 1
				}
			},
			"required": ["context"],
			"additionalProperties": false
		},
		"outputSchema": {
			"$schema": "https://json-schema.org/draft/2020-12/schema",
			"type": "object",
			"properties": {
				"context": {
					"type": "string",
					"minLength": 1,
					"description": "Opaque Lix context returned by SQL tools, open_lix or switch_branch"
				},
				"commit_id": {
					"type": "string"
				},
				"files": {
					"type": "array",
					"items": {
						"type": "object",
						"properties": {
							"id": {
								"type": "string"
							},
							"path": {
								"type": "string"
							},
							"url": {
								"type": "string"
							}
						},
						"required": ["id", "path", "url"],
						"additionalProperties": false
					}
				},
				"truncated": {
					"type": "boolean"
				}
			},
			"required": ["context", "commit_id", "files", "truncated"],
			"additionalProperties": false
		},
		"annotations": {
			"readOnlyHint": true,
			"destructiveHint": false,
			"openWorldHint": false
		},
		"_meta": {
			"securitySchemes": [
				{
					"type": "noauth"
				}
			]
		}
	},
	{
		"name": "read_files",
		"title": "LixRay: Read files",
		"description": "Prefer this tool for ordinary reads; batch absolute paths together. Each returns id, canonical url, size, content as text, and lixcol_metadata: the JSON the app keeps per file, null when none (the CSV view stores its column model there under atelier_csv: { version: 1, columns: [{ id, header, index, type, options? }] }). A file whose bytes are not text, or that is over a megabyte, comes back with no content and an encoding of \"binary\" or \"too-large\" saying why; read its bytes with SQL (SELECT content FROM lix_file WHERE path = $1) when you need them. Paths that do not exist come back in missing. commit_id is the commit the read reflects; pass it to write_files as last_seen_commit_id.",
		"inputSchema": {
			"$schema": "https://json-schema.org/draft/2020-12/schema",
			"type": "object",
			"properties": {
				"context": {
					"type": "string",
					"minLength": 1,
					"description": "Opaque Lix context returned by SQL tools, open_lix or switch_branch"
				},
				"paths": {
					"minItems": 1,
					"maxItems": 100,
					"type": "array",
					"items": {
						"type": "string",
						"minLength": 1
					}
				}
			},
			"required": ["context", "paths"],
			"additionalProperties": false
		},
		"outputSchema": {
			"$schema": "https://json-schema.org/draft/2020-12/schema",
			"type": "object",
			"properties": {
				"context": {
					"type": "string",
					"minLength": 1,
					"description": "Opaque Lix context returned by SQL tools, open_lix or switch_branch"
				},
				"commit_id": {
					"type": "string"
				},
				"files": {
					"type": "array",
					"items": {
						"type": "object",
						"properties": {
							"id": {
								"type": "string"
							},
							"path": {
								"type": "string"
							},
							"url": {
								"type": "string"
							},
							"size": {
								"type": "integer",
								"minimum": -9007199254740991,
								"maximum": 9007199254740991
							},
							"content": {
								"type": "string"
							},
							"encoding": {
								"type": "string",
								"enum": ["binary", "too-large"]
							},
							"lixcol_metadata": {
								"anyOf": [
									{
										"type": "object",
										"propertyNames": {
											"type": "string"
										},
										"additionalProperties": {}
									},
									{
										"type": "null"
									}
								]
							}
						},
						"required": ["id", "path", "url", "size", "lixcol_metadata"],
						"additionalProperties": false
					}
				},
				"missing": {
					"type": "array",
					"items": {
						"type": "string"
					}
				}
			},
			"required": ["context", "commit_id", "files", "missing"],
			"additionalProperties": false
		},
		"annotations": {
			"readOnlyHint": true,
			"destructiveHint": false,
			"openWorldHint": false
		},
		"_meta": {
			"securitySchemes": [
				{
					"type": "noauth"
				}
			]
		}
	},
	{
		"name": "write_files",
		"title": "LixRay: Write files",
		"description": "Prefer this tool to create/update files in one atomic commit, parent directories included. Each file takes content (text) or content_base64 (bytes), not both, and optionally lixcol_metadata (omitted keeps it, an object replaces it, null clears it); metadata alone updates an existing file. With last_seen_commit_id, a file that changed since that commit refuses the whole write: the error carries current_commit_id and the current content of the conflicting files, so merge and write again; unrelated changes never block. checkpoint: true marks the resulting commit. Already saved on success; read back if the outcome is uncertain or validation is requested. MCP Apps hosts render a collapsible card of the files written, with Atelier's view of each Markdown or CSV change; name the change in one sentence rather than listing the files. Other hosts receive the same saved receipt and file links; do not assume a card was displayed. When asked to reverse this write, prefer undo if it is still the latest undoable change; undo cannot target a commit ID. Rename, delete, and everything else: execute_sql on lix_file and lix_directory.",
		"inputSchema": {
			"$schema": "https://json-schema.org/draft/2020-12/schema",
			"type": "object",
			"properties": {
				"context": {
					"type": "string",
					"minLength": 1,
					"description": "Opaque Lix context returned by SQL tools, open_lix or switch_branch"
				},
				"files": {
					"minItems": 1,
					"maxItems": 100,
					"type": "array",
					"items": {
						"type": "object",
						"properties": {
							"path": {
								"type": "string",
								"minLength": 1
							},
							"content": {
								"type": "string"
							},
							"content_base64": {
								"type": "string"
							},
							"lixcol_metadata": {
								"anyOf": [
									{
										"type": "object",
										"propertyNames": {
											"type": "string"
										},
										"additionalProperties": {}
									},
									{
										"type": "null"
									}
								]
							}
						},
						"required": ["path"],
						"additionalProperties": false
					}
				},
				"last_seen_commit_id": {
					"type": "string",
					"minLength": 1,
					"description": "Lix commit id"
				},
				"checkpoint": {
					"type": "boolean"
				}
			},
			"required": ["context", "files"],
			"additionalProperties": false
		},
		"outputSchema": {
			"$schema": "https://json-schema.org/draft/2020-12/schema",
			"type": "object",
			"properties": {
				"context": {
					"type": "string",
					"minLength": 1,
					"description": "Opaque Lix context returned by SQL tools, open_lix or switch_branch"
				},
				"commit_id": {
					"type": "string"
				},
				"files": {
					"type": "array",
					"items": {
						"type": "object",
						"properties": {
							"id": {
								"type": "string"
							},
							"path": {
								"type": "string"
							},
							"url": {
								"type": "string"
							}
						},
						"required": ["id", "path", "url"],
						"additionalProperties": false
					}
				},
				"checkpoint_commit_id": {
					"type": "string"
				},
				"commit": {
					"anyOf": [
						{
							"type": "object",
							"properties": {
								"before": {
									"type": "string"
								},
								"after": {
									"type": "string"
								}
							},
							"required": ["before", "after"],
							"additionalProperties": false
						},
						{
							"type": "null"
						}
					]
				},
				"warning": {
					"type": "string"
				}
			},
			"required": ["context", "files", "commit"],
			"additionalProperties": false
		},
		"annotations": {
			"readOnlyHint": false,
			"destructiveHint": true,
			"idempotentHint": false,
			"openWorldHint": false
		},
		"_meta": {
			"securitySchemes": [
				{
					"type": "noauth"
				}
			],
			"ui": {
				"resourceUri": "ui://lixray/diff-card/v1"
			}
		}
	},
	{
		"name": "diff",
		"title": "LixRay: Diff two points",
		"description": "List the files that differ between two points of the Lix in context, each added, modified, removed, or moved (with before_path). before and after are each { checkpoint_id }, { commit_id }, { branch_id }, \"working\" (the branch as it stands), or \"latest_checkpoint\" (the nearest checkpoint behind it); paths narrows the list. Read-only. \"What changed since the last checkpoint\" is { before: \"latest_checkpoint\", after: \"working\" }. MCP Apps hosts render the same collapsible card a write shows; summarize in one sentence rather than listing the files.",
		"inputSchema": {
			"$schema": "https://json-schema.org/draft/2020-12/schema",
			"type": "object",
			"properties": {
				"context": {
					"type": "string",
					"minLength": 1,
					"description": "Opaque Lix context returned by SQL tools, open_lix or switch_branch"
				},
				"before": {
					"anyOf": [
						{
							"type": "object",
							"properties": {
								"checkpoint_id": {
									"type": "string",
									"minLength": 1,
									"description": "Lix commit id"
								}
							},
							"required": ["checkpoint_id"],
							"additionalProperties": false
						},
						{
							"type": "object",
							"properties": {
								"commit_id": {
									"type": "string",
									"minLength": 1,
									"description": "Lix commit id"
								}
							},
							"required": ["commit_id"],
							"additionalProperties": false
						},
						{
							"type": "object",
							"properties": {
								"branch_id": {
									"type": "string",
									"minLength": 1,
									"description": "Lix branch id"
								}
							},
							"required": ["branch_id"],
							"additionalProperties": false
						},
						{
							"type": "string",
							"const": "working"
						},
						{
							"type": "string",
							"const": "latest_checkpoint"
						}
					]
				},
				"after": {
					"anyOf": [
						{
							"type": "object",
							"properties": {
								"checkpoint_id": {
									"type": "string",
									"minLength": 1,
									"description": "Lix commit id"
								}
							},
							"required": ["checkpoint_id"],
							"additionalProperties": false
						},
						{
							"type": "object",
							"properties": {
								"commit_id": {
									"type": "string",
									"minLength": 1,
									"description": "Lix commit id"
								}
							},
							"required": ["commit_id"],
							"additionalProperties": false
						},
						{
							"type": "object",
							"properties": {
								"branch_id": {
									"type": "string",
									"minLength": 1,
									"description": "Lix branch id"
								}
							},
							"required": ["branch_id"],
							"additionalProperties": false
						},
						{
							"type": "string",
							"const": "working"
						},
						{
							"type": "string",
							"const": "latest_checkpoint"
						}
					]
				},
				"paths": {
					"minItems": 1,
					"maxItems": 100,
					"type": "array",
					"items": {
						"type": "string",
						"minLength": 1
					}
				}
			},
			"required": ["context", "before", "after"],
			"additionalProperties": false
		},
		"outputSchema": {
			"$schema": "https://json-schema.org/draft/2020-12/schema",
			"type": "object",
			"properties": {
				"context": {
					"type": "string",
					"minLength": 1,
					"description": "Opaque Lix context returned by SQL tools, open_lix or switch_branch"
				},
				"files": {
					"type": "array",
					"items": {
						"type": "object",
						"properties": {
							"path": {
								"type": "string"
							},
							"status": {
								"type": "string",
								"enum": ["added", "modified", "removed", "moved"]
							},
							"before_path": {
								"type": "string"
							},
							"before_commit_id": {
								"type": "string"
							},
							"after_commit_id": {
								"type": "string"
							},
							"url": {
								"type": "string"
							}
						},
						"required": [
							"path",
							"status",
							"before_commit_id",
							"after_commit_id",
							"url"
						],
						"additionalProperties": false
					}
				},
				"before": {
					"type": "string"
				},
				"after": {
					"type": "string"
				},
				"commit_id": {
					"type": "string"
				},
				"url": {
					"type": "string"
				}
			},
