[
	{
		"name": "list_lixes",
		"title": "LixRay: Discover lixes",
		"description": "List the lixes the signed-in user can access, each as @handle/slug plus uuid. Call only when the target Lix is unknown; With an exact reference, use open_lix for file-tool context or lix_ref directly for SQL.",
		"inputSchema": {
			"$schema": "https://json-schema.org/draft/2020-12/schema",
			"type": "object",
			"properties": {},
			"additionalProperties": false
		},
		"outputSchema": {
			"$schema": "https://json-schema.org/draft/2020-12/schema",
			"type": "object",
			"properties": {
				"lixes": {
					"type": "array",
					"items": {
						"type": "object",
						"properties": {
							"id": {
								"type": "string"
							},
							"name": {
								"type": "string"
							},
							"slug": {
								"type": "string"
							},
							"namespace": {
								"type": "object",
								"properties": {
									"handle": {
										"type": "string"
									}
								},
								"required": ["handle"],
								"additionalProperties": false
							}
						},
						"required": ["id", "name", "slug", "namespace"],
						"additionalProperties": false
					}
				}
			},
			"required": ["lixes"],
			"additionalProperties": false
		},
		"annotations": {
			"readOnlyHint": true,
			"destructiveHint": false,
			"openWorldHint": false
		},
		"_meta": {
			"securitySchemes": [
				{
					"type": "noauth"
				}
			]
		}
	},
	{
		"name": "open_lix",
		"title": "LixRay: Open a Lix",
		"description": "Open exact @handle/slug or UUID without calling list_lixes first; mint context on the active branch or branch_id. Returns counts, SQL file_paths, and files with id, path, ID-only url and pathful display_url. Branchless URLs follow the current default; ?branch pins its branch ID. Use file_paths if file_paths_complete.",
		"inputSchema": {
			"$schema": "https://json-schema.org/draft/2020-12/schema",
			"type": "object",
			"properties": {
				"lix_ref": {
					"type": "string",
					"minLength": 1,
					"description": "Lix UUID, slug, or @namespace/slug reference"
				},
				"branch_id": {
					"type": "string",
					"minLength": 1,
					"description": "Lix branch id"
				}
			},
			"required": ["lix_ref"],
			"additionalProperties": false
		},
		"outputSchema": {
			"$schema": "https://json-schema.org/draft/2020-12/schema",
			"type": "object",
			"properties": {
				"context": {
					"type": "string",
					"minLength": 1,
					"description": "Opaque Lix context returned by SQL tools, open_lix or switch_branch"
				},
				"context_expires_at": {
					"type": "string"
				},
				"id": {
					"type": "string"
				},
				"url": {
					"type": "string"
				},
				"lix_ref": {
					"type": "string"
				},
				"name": {
					"type": "string"
				},
				"branch_id": {
					"type": "string",
					"minLength": 1,
					"description": "Lix branch id"
				},
				"commit_id": {
					"type": "string"
				},
				"file_count": {
					"type": "integer",
					"minimum": -9007199254740991,
					"maximum": 9007199254740991
				},
				"directory_count": {
					"type": "integer",
					"minimum": -9007199254740991,
					"maximum": 9007199254740991
				},
				"files": {
					"type": "array",
					"items": {
						"type": "object",
						"properties": {
							"id": {
								"type": "string"
							},
							"path": {
								"type": "string"
							},
							"url": {
								"type": "string"
							},
							"display_url": {
								"type": "string"
							}
						},
						"required": ["id", "path", "url", "display_url"],
						"additionalProperties": false
					}
				},
				"file_paths": {
					"type": "array",
					"items": {
						"type": "string"
					}
				},
				"file_paths_complete": {
					"type": "boolean"
				},
				"file_paths_sql": {
					"type": "string"
				},
				"empty": {
					"type": "boolean"
				}
			},
			"required": [
				"context",
				"context_expires_at",
				"id",
				"url",
				"lix_ref",
				"name",
				"branch_id",
				"commit_id",
				"file_count",
				"directory_count",
				"files",
				"file_paths",
				"file_paths_complete",
				"empty"
			],
			"additionalProperties": false
		},
		"annotations": {
			"readOnlyHint": true,
			"destructiveHint": false,
			"openWorldHint": false
		},
		"_meta": {
			"securitySchemes": [
				{
					"type": "noauth"
				}
			]
		}
	},
	{
		"name": "get_entity_urls",
		"title": "LixRay: Get item links",
		"description": "Resolve up to 50 files/folders by id or absolute path in the context branch. Returns ID-only url for stored links and pathful display_url for users. Branchless URLs follow the current default; ?branch pins its branch ID. Root folder returns the repository URL. Read-only.",
		"inputSchema": {
			"$schema": "https://json-schema.org/draft/2020-12/schema",
			"type": "object",
			"properties": {
				"context": {
					"type": "string",
					"minLength": 1,
					"description": "Opaque Lix context returned by SQL tools, open_lix or switch_branch"
				},
				"entities": {
					"minItems": 1,
					"maxItems": 50,
					"type": "array",
					"items": {
						"anyOf": [
							{
								"type": "object",
								"properties": {
									"kind": {
										"type": "string",
										"enum": ["file", "directory"]
									},
									"id": {
										"type": "string",
										"format": "uuid",
										"pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
									}
								},
								"required": ["kind", "id"],
								"additionalProperties": false
							},
							{
								"type": "object",
								"properties": {
									"kind": {
										"type": "string",
										"enum": ["file", "directory"]
									},
									"path": {
										"type": "string",
										"pattern": "^\\/.*"
									}
								},
								"required": ["kind", "path"],
								"additionalProperties": false
							}
						]
					}
				}
			},
			"required": ["context", "entities"],
			"additionalProperties": false
		},
		"outputSchema": {
			"$schema": "https://json-schema.org/draft/2020-12/schema",
			"type": "object",
			"properties": {
				"context": {
					"type": "string",
					"minLength": 1,
					"description": "Opaque Lix context returned by SQL tools, open_lix or switch_branch"
				},
				"entities": {
					"type": "array",
					"items": {
						"type": "object",
						"properties": {
							"kind": {
								"type": "string",
								"enum": ["file", "directory"]
							},
							"id": {
								"anyOf": [
									{
										"type": "string"
									},
									{
										"type": "null"
									}
								]
							},
							"path": {
								"type": "string"
							},
							"url": {
								"type": "string"
							},
							"display_url": {
								"type": "string"
							}
						},
						"required": ["kind", "id", "path", "url", "display_url"],
						"additionalProperties": false
					}
				}
			},
			"required": ["context", "entities"],
			"additionalProperties": false
		},
		"annotations": {
			"readOnlyHint": true,
			"destructiveHint": false,
			"openWorldHint": false
		},
		"_meta": {
			"securitySchemes": [
				{
					"type": "noauth"
				}
			]
		}
	},
	{
		"name": "list_files",
		"title": "LixRay: List files",
		"description": "List the files of the Lix and branch in context with id, path, stable url for documents, and readable display_url for users, sorted by path. Optional directory (an absolute path prefix such as /gtm) and name (a case-insensitive substring of the file name) narrow the list; truncated says to narrow further. Read-only.",
		"inputSchema": {
			"$schema": "https://json-schema.org/draft/2020-12/schema",
			"type": "object",
			"properties": {
				"context": {
					"type": "string",
					"minLength": 1,
					"description": "Opaque Lix context returned by SQL tools, open_lix or switch_branch"
				},
				"directory": {
					"type": "string",
					"minLength": 1
				},
				"name": {
					"type": "string",
					"minLength": 1
				}
			},
			"required": ["context"],
			"additionalProperties": false
		},
		"outputSchema": {
			"$schema": "https://json-schema.org/draft/2020-12/schema",
			"type": "object",
			"properties": {
				"context": {
					"type": "string",
					"minLength": 1,
					"description": "Opaque Lix context returned by SQL tools, open_lix or switch_branch"
				},
				"commit_id": {
					"type": "string"
				},
				"files": {
					"type": "array",
					"items": {
						"type": "object",
						"properties": {
							"id": {
								"type": "string"
							},
							"path": {
								"type": "string"
							},
							"url": {
								"type": "string"
							},
							"display_url": {
								"type": "string"
							}
						},
						"required": ["id", "path", "url", "display_url"],
						"additionalProperties": false
					}
				},
				"truncated": {
					"type": "boolean"
				}
			},
			"required": ["context", "commit_id", "files", "truncated"],
			"additionalProperties": false
		},
		"annotations": {
			"readOnlyHint": true,
			"destructiveHint": false,
			"openWorldHint": false
		},
		"_meta": {
			"securitySchemes": [
				{
					"type": "noauth"
				}
			]
		}
	},
	{
		"name": "read_files",
		"title": "LixRay: Read files",
		"description": "Prefer this tool for ordinary reads; batch absolute paths together. Each returns id, stable url for documents, readable display_url for users, size, content as text, and lixcol_metadata: the JSON the app keeps per file, null when none (the CSV view stores its column model there under atelier_csv: { version: 1, columns: [{ id, header, index, type, options? }] }). A file whose bytes are not text, or that is over a megabyte, comes back with no content and an encoding of \"binary\" or \"too-large\" saying why; read its bytes with SQL (SELECT content FROM lix_file WHERE path = $1) when you need them. Paths that do not exist come back in missing. commit_id is the commit the read reflects; pass it to execute_sql as last_seen_commit_id.",
		"inputSchema": {
			"$schema": "https://json-schema.org/draft/2020-12/schema",
			"type": "object",
			"properties": {
				"context": {
					"type": "string",
					"minLength": 1,
					"description": "Opaque Lix context returned by SQL tools, open_lix or switch_branch"
				},
				"paths": {
					"minItems": 1,
					"maxItems": 100,
					"type": "array",
					"items": {
						"type": "string",
						"minLength": 1
					}
				}
			},
			"required": ["context", "paths"],
			"additionalProperties": false
		},
		"outputSchema": {
			"$schema": "https://json-schema.org/draft/2020-12/schema",
			"type": "object",
			"properties": {
				"context": {
					"type": "string",
					"minLength": 1,
					"description": "Opaque Lix context returned by SQL tools, open_lix or switch_branch"
				},
				"commit_id": {
					"type": "string"
				},
				"files": {
					"type": "array",
					"items": {
						"type": "object",
						"properties": {
							"id": {
								"type": "string"
							},
							"path": {
								"type": "string"
							},
							"url": {
								"type": "string"
							},
							"display_url": {
								"type": "string"
							},
							"size": {
								"type": "integer",
								"minimum": -9007199254740991,
								"maximum": 9007199254740991
							},
							"content": {
								"type": "string"
							},
							"encoding": {
								"type": "string",
								"enum": ["binary", "too-large"]
							},
							"lixcol_metadata": {
								"anyOf": [
									{
										"type": "object",
										"propertyNames": {
											"type": "string"
										},
										"additionalProperties": {}
									},
									{
										"type": "null"
									}
								]
							}
						},
						"required": [
							"id",
							"path",
							"url",
							"display_url",
							"size",
							"lixcol_metadata"
						],
						"additionalProperties": false
					}
				},
				"missing": {
					"type": "array",
					"items": {
						"type": "string"
					}
				}
			},
			"required": ["context", "commit_id", "files", "missing"],
			"additionalProperties": false
		},
		"annotations": {
			"readOnlyHint": true,
			"destructiveHint": false,
			"openWorldHint": false
		},
		"_meta": {
			"securitySchemes": [
				{
					"type": "noauth"
				}
			]
		}
	},
	{
		"name": "diff",
		"title": "LixRay: Diff two points",
		"description": "List the files that differ between two points of the Lix in context, each added, modified, removed, or moved (with before_path). before and after are each { checkpoint_id }, { commit_id }, { branch_id }, \"working\" (the branch as it stands), or \"latest_checkpoint\" (the nearest checkpoint behind it); paths narrows the list. Read-only. \"What changed since the last checkpoint\" is { before: \"latest_checkpoint\", after: \"working\" }. MCP Apps hosts render the same collapsible card a write shows; summarize in one sentence rather than listing the files.",
		"inputSchema": {
			"$schema": "https://json-schema.org/draft/2020-12/schema",
			"type": "object",
			"properties": {
				"context": {
					"type": "string",
					"minLength": 1,
					"description": "Opaque Lix context returned by SQL tools, open_lix or switch_branch"
				},
				"before": {
					"anyOf": [
						{
							"type": "object",
							"properties": {
								"checkpoint_id": {
									"type": "string",
									"minLength": 1,
									"description": "Lix commit id"
								}
							},
							"required": ["checkpoint_id"],
							"additionalProperties": false
						},
						{
							"type": "object",
							"properties": {
								"commit_id": {
									"type": "string",
									"minLength": 1,
									"description": "Lix commit id"
								}
							},
							"required": ["commit_id"],
							"additionalProperties": false
						},
						{
							"type": "object",
							"properties": {
								"branch_id": {
									"type": "string",
									"minLength": 1,
									"description": "Lix branch id"
								}
							},
							"required": ["branch_id"],
							"additionalProperties": false
						},
						{
							"type": "string",
							"const": "working"
						},
						{
							"type": "string",
							"const": "latest_checkpoint"
						}
					]
				},
				"after": {
					"anyOf": [
						{
							"type": "object",
							"properties": {
								"checkpoint_id": {
									"type": "string",
									"minLength": 1,
									"description": "Lix commit id"
								}
							},
							"required": ["checkpoint_id"],
							"additionalProperties": false
						},
						{
							"type": "object",
							"properties": {
								"commit_id": {
									"type": "string",
									"minLength": 1,
									"description": "Lix commit id"
								}
							},
							"required": ["commit_id"],
							"additionalProperties": false
						},
						{
							"type": "object",
							"properties": {
								"branch_id": {
									"type": "string",
									"minLength": 1,
									"description": "Lix branch id"
								}
							},
							"required": ["branch_id"],
							"additionalProperties": false
						},
						{
							"type": "string",
							"const": "working"
						},
						{
							"type": "string",
							"const": "latest_checkpoint"
						}
					]
				},
				"paths": {
					"minItems": 1,
					"maxItems": 100,
					"type": "array",
					"items": {
						"type": "string",
						"minLength": 1
					}
				}
			},
			"required": ["context", "before", "after"],
			"additionalProperties": false
		},
		"outputSchema": {
			"$schema": "https://json-schema.org/draft/2020-12/schema",
			"type": "object",
			"properties": {
				"context": {
					"type": "string",
					"minLength": 1,
					"description": "Opaque Lix context returned by SQL tools, open_lix or switch_branch"
				},
				"files": {
					"type": "array",
					"items": {
						"type": "object",
						"properties": {
							"path": {
								"type": "string"
							},
							"status": {
								"type": "string",
								"enum": ["added", "modified", "removed", "moved"]
							},
							"before_path": {
								"type": "string"
							},
							"before_commit_id": {
								"type": "string"
							},
							"after_commit_id": {
								"type": "string"
							},
							"url": {
								"type": "string"
							},
							"display_url": {
								"type": "string"
							}
						},
						"required": [
							"path",
							"status",
							"before_commit_id",
							"after_commit_id",
							"url",
							"display_url"
						],
						"additionalProperties": false
					}
				},
				"before": {
					"type": "string"
				},
				"after": {
					"type": "string"
				},
				"commit_id": {
					"type": "string"
				},
				"url": {
					"type": "string"
				}
			},
			"required": ["context", "files", "before", "after", "commit_id", "url"],
			"additionalProperties": false
		},
		"annotations": {
			"readOnlyHint": true,
			"destructiveHint": false,
			"openWorldHint": false
		},
		"_meta": {
			"securitySchemes": [
				{
					"type": "noauth"
				}
			],
			"ui": {
				"resourceUri": "ui://lixray/diff-card/v1"
			}
		}
	},
	{
		"name": "query_sql",
		"title": "LixRay: Query SQL",
		"description": "Run one read-only SQL statement against lix_ref (@handle/slug or UUID), optionally branch_id. Defaults to the repository default branch; no open_lix needed. Or pass context alone for its pinned branch. INSERT, UPDATE, and DELETE are rejected; use execute_sql for writes.\n\nPrefer read_files and list_files for ordinary file work; use query_sql for repository data. Lix SQL is a Postgres dialect subset, not SQLite: there is no sqlite_master and no PRAGMA. Discover tables with `SELECT table_name, table_type FROM information_schema.tables WHERE table_schema = 'public' ORDER BY table_name;` and columns with `SELECT column_name, data_type, is_nullable, description FROM information_schema.columns WHERE table_schema = 'public' AND table_name = $1 ORDER BY ordinal_position;`. Core tables: lix_file (id, path, directory_id, name, content), lix_directory (id, path, parent_id, name), lix_branch, lix_commit, lix_change; entity tables are repository-defined, so discover them rather than guess. Parameters are $1, $2, … given as params: [{ kind: \"text\", value: \"…\" }]. History: lix_log([anchor]) lists retained commits with active checkpoint metadata; lix_history('lix_file'[, anchor]) gives net changes; lix_diff('lix_file') gives working changes; lix_as_of('lix_file', $1) gives state at a commit. Join log to history on destination commit ID for checkpoint filters.",
		"inputSchema": {
			"$schema": "https://json-schema.org/draft/2020-12/schema",
			"type": "object",
			"properties": {
				"context": {
					"type": "string",
					"minLength": 1,
					"description": "Opaque Lix context returned by SQL tools, open_lix or switch_branch"
				},
				"lix_ref": {
					"description": "Exact @handle/slug or UUID. No open_lix call required.",
					"type": "string",
					"minLength": 1
				},
				"branch_id": {
					"description": "Defaults to the repository default branch when lix_ref is used.",
					"type": "string",
					"minLength": 1
				},
				"sql": {
					"type": "string",
					"minLength": 1
				},
				"params": {
					"type": "array",
					"items": {
						"anyOf": [
							{
								"type": "object",
								"properties": {
									"kind": {
										"type": "string",
										"const": "null"
									},
									"value": {
										"type": "null"
									}
								},
								"required": ["kind"],
								"additionalProperties": false
							},
							{
								"type": "object",
								"properties": {
									"kind": {
										"type": "string",
										"const": "bool"
									},
									"value": {
										"type": "boolean"
									}
								},
								"required": ["kind", "value"],
								"additionalProperties": false
							},
							{
								"type": "object",
								"properties": {
									"kind": {
										"type": "string",
										"const": "int"
									},
									"value": {
										"type": "integer",
										"minimum": -9007199254740991,
										"maximum": 9007199254740991
									}
								},
								"required": ["kind", "value"],
								"additionalProperties": false
							},
							{
								"type": "object",
								"properties": {
