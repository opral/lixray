												"kind": {
													"type": "string",
													"const": "int"
												},
												"value": {
													"type": "integer",
													"minimum": -9007199254740991,
													"maximum": 9007199254740991
												}
											},
											"required": ["kind", "value"],
											"additionalProperties": false
										},
										{
											"type": "object",
											"properties": {
												"kind": {
													"type": "string",
													"const": "float"
												},
												"value": {
