[
	{
		"name": "list_lixes",
		"title": "LixRay: Discover lixes",
		"description": "List the lixes the signed-in user can access, each as @handle/slug plus uuid. Call only when the target Lix is unknown; with an exact reference, call open_lix directly.",
		"inputSchema": {
			"$schema": "https://json-schema.org/draft/2020-12/schema",
			"type": "object",
			"properties": {},
			"additionalProperties": false
		},
		"outputSchema": {
			"$schema": "https://json-schema.org/draft/2020-12/schema",
			"type": "object",
			"properties": {
				"lixes": {
					"type": "array",
					"items": {
						"type": "object",
						"properties": {
							"id": {
								"type": "string"
							},
							"name": {
								"type": "string"
							},
							"slug": {
								"type": "string"
							},
							"namespace": {
								"type": "object",
								"properties": {
									"id": {
										"type": "string"
									},
									"name": {
										"type": "string"
									},
									"handle": {
										"type": "string"
									}
								},
								"required": ["id", "name", "handle"],
								"additionalProperties": false
							}
						},
						"required": ["id", "name", "slug", "namespace"],
						"additionalProperties": false
					}
				},
				"request_id": {
					"type": "string",
					"minLength": 1,
					"description": "Request ID for correlating this response with server telemetry"
				}
			},
			"required": ["lixes", "request_id"],
			"additionalProperties": false
		},
		"annotations": {
			"readOnlyHint": true,
			"destructiveHint": false,
			"openWorldHint": false
		},
		"_meta": {
			"securitySchemes": [
				{
					"type": "noauth"
				}
			]
		}
	},
	{
		"name": "open_lix",
		"title": "LixRay: Open a Lix",
		"description": "Open a Lix by exact @handle/slug or UUID without calling list_lixes first, and mint the context later tools require (active branch unless branch_id is given). Returns counts, file_paths (SQL paths, not URLs), and files with id, path, and canonical url; when file_paths_complete is true, do not list files again.",
		"inputSchema": {
			"$schema": "https://json-schema.org/draft/2020-12/schema",
			"type": "object",
			"properties": {
				"lix_ref": {
					"type": "string",
					"minLength": 1,
					"description": "Lix UUID, slug, or @namespace/slug reference"
				},
				"branch_id": {
					"type": "string",
					"minLength": 1,
					"description": "Lix branch id"
				}
			},
			"required": ["lix_ref"],
			"additionalProperties": false
		},
		"outputSchema": {
			"$schema": "https://json-schema.org/draft/2020-12/schema",
			"type": "object",
			"properties": {
				"context": {
					"type": "string",
					"minLength": 1,
					"description": "Opaque Lix context returned by open_lix or switch_branch"
				},
				"context_expires_at": {
					"type": "string"
				},
				"id": {
					"type": "string"
				},
				"url": {
					"type": "string"
				},
				"lix_ref": {
					"type": "string"
				},
				"name": {
					"type": "string"
				},
				"branch_id": {
					"type": "string",
					"minLength": 1,
					"description": "Lix branch id"
				},
				"commit_id": {
					"type": "string"
				},
				"file_count": {
					"type": "integer",
					"minimum": -9007199254740991,
					"maximum": 9007199254740991
				},
				"directory_count": {
					"type": "integer",
					"minimum": -9007199254740991,
					"maximum": 9007199254740991
				},
				"files": {
					"type": "array",
					"items": {
						"type": "object",
						"properties": {
							"id": {
								"type": "string"
							},
							"path": {
								"type": "string"
							},
							"url": {
								"type": "string"
							}
						},
						"required": ["id", "path", "url"],
						"additionalProperties": false
					}
				},
				"file_paths": {
					"type": "array",
					"items": {
						"type": "string"
					}
				},
				"file_paths_complete": {
					"type": "boolean"
				},
				"file_paths_sql": {
					"type": "string"
				},
				"empty": {
					"type": "boolean"
				},
				"request_id": {
					"type": "string",
					"minLength": 1,
					"description": "Request ID for correlating this response with server telemetry"
				}
			},
			"required": [
				"context",
				"context_expires_at",
				"id",
				"url",
				"lix_ref",
				"name",
				"branch_id",
				"commit_id",
				"file_count",
				"directory_count",
				"files",
				"file_paths",
				"file_paths_complete",
				"empty",
				"request_id"
			],
			"additionalProperties": false
		},
		"annotations": {
			"readOnlyHint": true,
			"destructiveHint": false,
			"openWorldHint": false
		},
		"_meta": {
			"securitySchemes": [
				{
					"type": "noauth"
				}
			]
		}
	},
	{
		"name": "get_entity_urls",
		"title": "LixRay: Get canonical item URLs",
		"description": "Return canonical browser URLs for up to 50 files or directories in the Lix and branch in context, each given by kind and exactly one of id or absolute path. Use after writes or renames, or for items absent from open_lix.files; copy the returned urls exactly. Read-only; directory path / is the repository URL.",
		"inputSchema": {
			"$schema": "https://json-schema.org/draft/2020-12/schema",
			"type": "object",
			"properties": {
				"context": {
					"type": "string",
					"minLength": 1,
					"description": "Opaque Lix context returned by open_lix or switch_branch"
				},
				"entities": {
					"minItems": 1,
					"maxItems": 50,
					"type": "array",
					"items": {
						"anyOf": [
							{
								"type": "object",
								"properties": {
									"kind": {
										"type": "string",
										"enum": ["file", "directory"]
									},
									"id": {
										"type": "string",
										"format": "uuid",
										"pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
									}
								},
								"required": ["kind", "id"],
								"additionalProperties": false
							},
							{
								"type": "object",
								"properties": {
									"kind": {
										"type": "string",
										"enum": ["file", "directory"]
									},
									"path": {
										"type": "string",
										"pattern": "^\\/.*"
									}
								},
								"required": ["kind", "path"],
								"additionalProperties": false
							}
						]
					}
				}
			},
			"required": ["context", "entities"],
			"additionalProperties": false
		},
		"outputSchema": {
			"$schema": "https://json-schema.org/draft/2020-12/schema",
			"type": "object",
			"properties": {
				"context": {
					"type": "string",
					"minLength": 1,
					"description": "Opaque Lix context returned by open_lix or switch_branch"
				},
				"entities": {
					"type": "array",
					"items": {
						"type": "object",
						"properties": {
							"kind": {
								"type": "string",
								"enum": ["file", "directory"]
							},
							"id": {
								"anyOf": [
									{
										"type": "string"
									},
									{
										"type": "null"
									}
								]
							},
							"path": {
								"type": "string"
							},
							"url": {
								"type": "string"
							}
						},
						"required": ["kind", "id", "path", "url"],
						"additionalProperties": false
					}
				},
				"request_id": {
					"type": "string",
					"minLength": 1,
					"description": "Request ID for correlating this response with server telemetry"
				}
			},
			"required": ["context", "entities", "request_id"],
			"additionalProperties": false
		},
		"annotations": {
			"readOnlyHint": true,
			"destructiveHint": false,
			"openWorldHint": false
		},
		"_meta": {
			"securitySchemes": [
				{
					"type": "noauth"
				}
			]
		}
	},
	{
		"name": "query_sql",
		"title": "LixRay: Query SQL",
		"description": "Run one read-only SQL statement against the Lix and branch in context. INSERT, UPDATE, and DELETE are rejected; use execute_sql for writes.\n\nLix SQL is a Postgres dialect subset, not SQLite: there is no sqlite_master and no PRAGMA. Discover tables with `SELECT table_name, table_type FROM information_schema.tables WHERE table_schema = 'public' ORDER BY table_name;` and columns, with their descriptions, with `SELECT column_name, data_type, is_nullable, description FROM information_schema.columns WHERE table_schema = 'public' AND table_name = $1 ORDER BY ordinal_position;`. Core tables: lix_file (id, path, directory_id, name, content), lix_directory (id, path, parent_id, name), lix_branch, lix_commit, lix_change; entity tables are repository-defined, so discover them rather than guess. Parameters are $1, $2, … given as params: [{ kind: \"text\", value: \"…\" }] (kinds: text, int, float, json, blob). Read a text file with `SELECT path, CAST(content AS TEXT) AS content FROM lix_file WHERE path = $1`, and several at once with `WHERE path IN ($1, $2)` in one statement. History: lix_log() lists retained commits, lix_history('lix_file') the net change per commit, lix_diff('lix_file') the working changes, lix_as_of('lix_file', $1) the state at a commit.",
		"inputSchema": {
			"$schema": "https://json-schema.org/draft/2020-12/schema",
			"type": "object",
			"properties": {
				"context": {
					"type": "string",
					"minLength": 1,
					"description": "Opaque Lix context returned by open_lix or switch_branch"
				},
				"sql": {
					"type": "string",
					"minLength": 1
				},
				"params": {
					"type": "array",
					"items": {
						"anyOf": [
							{
								"type": "object",
								"properties": {
									"kind": {
										"type": "string",
										"const": "null"
									},
									"value": {
										"type": "null"
									}
								},
								"required": ["kind"],
								"additionalProperties": false
							},
							{
								"type": "object",
								"properties": {
									"kind": {
										"type": "string",
										"const": "bool"
									},
									"value": {
										"type": "boolean"
									}
								},
								"required": ["kind", "value"],
								"additionalProperties": false
							},
							{
								"type": "object",
								"properties": {
									"kind": {
										"type": "string",
										"const": "int"
									},
									"value": {
										"type": "integer",
										"minimum": -9007199254740991,
										"maximum": 9007199254740991
									}
								},
								"required": ["kind", "value"],
								"additionalProperties": false
							},
							{
								"type": "object",
								"properties": {
									"kind": {
										"type": "string",
										"const": "float"
									},
									"value": {
										"type": "number"
									}
								},
								"required": ["kind", "value"],
								"additionalProperties": false
							},
							{
								"type": "object",
								"properties": {
									"kind": {
										"type": "string",
										"const": "text"
									},
									"value": {
										"type": "string"
									}
								},
								"required": ["kind", "value"],
								"additionalProperties": false
							},
							{
								"type": "object",
								"properties": {
									"kind": {
										"type": "string",
										"const": "blob"
									},
									"base64": {
										"type": "string"
									}
								},
								"required": ["kind", "base64"],
								"additionalProperties": false
							},
							{
								"type": "object",
								"properties": {
									"kind": {
										"type": "string",
										"const": "json"
									},
									"value": {}
								},
								"required": ["kind", "value"],
								"additionalProperties": false
							}
						]
					}
				}
			},
			"required": ["context", "sql"],
			"additionalProperties": false
		},
		"outputSchema": {
			"$schema": "https://json-schema.org/draft/2020-12/schema",
			"type": "object",
			"properties": {
				"context": {
					"type": "string",
					"minLength": 1,
					"description": "Opaque Lix context returned by open_lix or switch_branch"
				},
				"result": {
					"type": "object",
					"properties": {
						"columns": {
							"type": "array",
							"items": {
								"type": "string"
							}
						},
						"rows": {
							"type": "array",
							"items": {
								"type": "array",
								"items": {}
							},
							"description": "Rows of wire values in the same {kind, value} shape as params"
						},
						"rowsAffected": {
							"type": "integer",
							"minimum": -9007199254740991,
							"maximum": 9007199254740991
						},
						"notices": {
							"type": "array",
							"items": {}
						}
					},
					"required": ["columns", "rows", "rowsAffected", "notices"],
					"additionalProperties": false
				},
				"request_id": {
					"type": "string",
					"minLength": 1,
					"description": "Request ID for correlating this response with server telemetry"
				}
			},
			"required": ["context", "result", "request_id"],
			"additionalProperties": false
		},
		"annotations": {
			"readOnlyHint": true,
			"destructiveHint": false,
			"openWorldHint": false
		},
		"_meta": {
			"securitySchemes": [
				{
					"type": "noauth"
				}
			]
		}
	},
	{
		"name": "execute_sql",
		"title": "Execute SQL atomically",
		"description": "Run an ordered atomic SQL batch against the Lix and branch in context. If any statement fails, the complete batch is rolled back; a returned result is already persisted.\n\nWrite a text file with `INSERT INTO lix_file (path, content) VALUES ($1, CAST($2 AS BYTEA)) ON CONFLICT (path) DO UPDATE SET content = excluded.content`, passing both params as kind \"text\" (binaries: kind \"blob\" without CAST; never CAST(... AS BLOB)). Create parent directories first, in the same batch: `INSERT INTO lix_directory (path) VALUES ($1) ON CONFLICT (path) DO NOTHING` (paths have no trailing slash: /skills, not /skills/). Rename with `UPDATE lix_file SET path = $1 WHERE path = $2`; delete with `DELETE FROM lix_file WHERE path = $1`. ON CONFLICT names its columns; ON CONSTRAINT and DO UPDATE WHERE are not supported. The result names what the batch wrote, with links; do not follow a write with a verification SELECT or any readback. Mark meaningful milestones with create_checkpoint; saving needs no checkpoint.",
		"inputSchema": {
			"$schema": "https://json-schema.org/draft/2020-12/schema",
			"type": "object",
			"properties": {
				"context": {
					"type": "string",
					"minLength": 1,
					"description": "Opaque Lix context returned by open_lix or switch_branch"
				},
				"statements": {
					"minItems": 1,
					"type": "array",
					"items": {
						"type": "object",
						"properties": {
							"sql": {
								"type": "string",
								"minLength": 1
							},
							"params": {
								"type": "array",
								"items": {
									"anyOf": [
										{
											"type": "object",
											"properties": {
												"kind": {
													"type": "string",
													"const": "null"
												},
												"value": {
													"type": "null"
												}
											},
											"required": ["kind"],
											"additionalProperties": false
										},
										{
											"type": "object",
											"properties": {
												"kind": {
													"type": "string",
													"const": "bool"
												},
												"value": {
													"type": "boolean"
												}
											},
											"required": ["kind", "value"],
											"additionalProperties": false
										},
										{
											"type": "object",
											"properties": {
												"kind": {
													"type": "string",
													"const": "int"
												},
												"value": {
													"type": "integer",
													"minimum": -9007199254740991,
													"maximum": 9007199254740991
												}
											},
											"required": ["kind", "value"],
											"additionalProperties": false
										},
										{
											"type": "object",
											"properties": {
												"kind": {
													"type": "string",
													"const": "float"
												},
												"value": {
													"type": "number"
												}
											},
											"required": ["kind", "value"],
											"additionalProperties": false
										},
										{
											"type": "object",
											"properties": {
												"kind": {
													"type": "string",
													"const": "text"
												},
												"value": {
													"type": "string"
												}
											},
											"required": ["kind", "value"],
											"additionalProperties": false
										},
										{
											"type": "object",
											"properties": {
												"kind": {
													"type": "string",
													"const": "blob"
												},
												"base64": {
													"type": "string"
												}
											},
											"required": ["kind", "base64"],
											"additionalProperties": false
										},
										{
											"type": "object",
											"properties": {
												"kind": {
													"type": "string",
													"const": "json"
												},
												"value": {}
											},
											"required": ["kind", "value"],
											"additionalProperties": false
										}
									]
								}
							}
						},
						"required": ["sql"],
						"additionalProperties": false
					}
				},
				"options": {
					"type": "object",
					"properties": {
						"origin_key": {
							"type": "string"
						}
					},
					"additionalProperties": false
				}
			},
			"required": ["context", "statements"],
			"additionalProperties": false
		},
		"outputSchema": {
			"$schema": "https://json-schema.org/draft/2020-12/schema",
			"type": "object",
			"properties": {
				"context": {
					"type": "string",
					"minLength": 1,
					"description": "Opaque Lix context returned by open_lix or switch_branch"
				},
				"results": {
					"type": "array",
					"items": {
						"type": "object",
						"properties": {
							"columns": {
								"type": "array",
								"items": {
									"type": "string"
								}
							},
							"rows": {
