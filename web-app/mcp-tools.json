							"sql": {
								"type": "string",
								"minLength": 1
							},
							"params": {
								"type": "array",
								"items": {
									"anyOf": [
										{
											"type": "object",
											"properties": {
												"kind": {
													"type": "string",
													"const": "null"
												},
												"value": {
