			"$schema": "https://json-schema.org/draft/2020-12/schema",
			"type": "object",
			"properties": {
				"lix_ref": {
					"type": "string",
					"minLength": 1,
					"description": "Lix UUID, slug, or @namespace/slug reference"
				},
				"branch_id": {
					"type": "string",
					"minLength": 1,
					"description": "Lix branch id"
				}
			},
			"required": ["lix_ref"],
			"additionalProperties": false
		},
		"outputSchema": {
			"$schema": "https://json-schema.org/draft/2020-12/schema",
			"type": "object",
			"anyOf": [
				{
					"type": "object",
					"properties": {
						"context": {
							"type": "string",
							"minLength": 1,
							"description": "Opaque Lix context returned by open_lix or switch_branch"
						},
						"context_expires_at": {
							"type": "string"
						},
						"id": {
							"type": "string"
						},
						"url": {
							"type": "string"
						},
						"lix_ref": {
							"type": "string"
						},
						"name": {
							"type": "string"
						},
						"branch_id": {
							"type": "string",
							"minLength": 1,
							"description": "Lix branch id"
						},
						"commit_id": {
							"type": "string"
						},
						"file_count": {
							"type": "integer",
							"minimum": -9007199254740991,
							"maximum": 9007199254740991
						},
						"directory_count": {
							"type": "integer",
							"minimum": -9007199254740991,
							"maximum": 9007199254740991
						},
						"file_paths": {
