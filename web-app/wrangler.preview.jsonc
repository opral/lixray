{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "lixray-preview",
	"account_id": "11a1a6f76d167248cc6987e978efb7e5",
	"main": "src/preview-server.ts",
	"compatibility_date": "2026-07-07",
	"compatibility_flags": [
		"nodejs_compat",
		"enable_request_signal",
		"enable_abortsignal_rpc",
	],
	"workers_dev": true,
	"preview_urls": true,
	"r2_buckets": [
		{
			"binding": "PREVIEW_STATE",
			"bucket_name": "lixray-preview",
		},
	],
	"vars": {
		"LIXRAY_DEMO": "1",
		"LIXRAY_DEMO_WORKSPACE_IDS": "00000000-0000-4000-8000-000000000002,00000000-0000-4000-8000-000000000003",
		"TSS_SHELL": "true",
		"VITE_LIXRAY_DEMO": "1",
	},
}
